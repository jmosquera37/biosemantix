# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------

# URL base del backend de BioSemantix usada por el frontend.
# Si se omite, el valor predeterminado es: http://127.0.0.1:8000
# En despliegue, define aquí la URL HTTPS real del backend.
# Nota: Vite solo expone al navegador las variables con el prefijo VITE_.
VITE_API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Backend (FastAPI)  — se leen del entorno del proceso, no las carga Vite
# ---------------------------------------------------------------------------

# Orígenes permitidos para CORS, separados por comas.
# Si se omite, se conservan los cuatro orígenes locales por defecto
# (http://localhost:5173, http://127.0.0.1:5173,
#  http://localhost:5174, http://127.0.0.1:5174).
# El comodín "*" nunca se permite.
# CORS_ALLOW_ORIGINS=https://<tu-dominio-real>.vercel.app

# Patrón (regex) opcional para permitir los previews de Vercel de ESTE proyecto.
# Ajústalo al nombre real del proyecto. No uses patrones que acepten dominios
# arbitrarios (por ejemplo, evita algo que termine en "vercel.app" sin más).
# CORS_ALLOW_ORIGIN_REGEX=^https://<proyecto>-[a-z0-9-]+\.vercel\.app$
